# node:20-slim (Debian) en vez de alpine: ffmpeg-static usa un binario glibc.
FROM node:20-slim

WORKDIR /app

COPY server/package.json server/package-lock.json ./
RUN npm install --omit=dev --no-audit --no-fund

# index.js importa ./r2.js y ./media.js — hay que copiarlos o crashea al arrancar.
COPY server/index.js server/r2.js server/media.js ./
# schemas para inicializar la DB si hiciera falta correrlos a mano
COPY server/schema.sql server/schema-catalog.sql ./

EXPOSE 3001
CMD ["node", "index.js"]
