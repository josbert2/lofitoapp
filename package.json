{
    "name": "lofi_chillhop",
    "version": "0.1.8",
    "private": true,
    "description": "Lofito — tu entorno de concentración",
    "author": "Lofito",
    "main": "build/electron.js",
    "homepage": "./",
    "dependencies": {
        "@emotion/react": "^11.10.5",
        "@emotion/styled": "^11.10.5",
        "@headlessui/react": "^1.6.6",
        "@lottiefiles/react-lottie-player": "^3.4.7",
        "@mui/icons-material": "^5.10.9",
        "@mui/material": "^5.10.11",
        "@testing-library/jest-dom": "^5.16.5",
        "@testing-library/react": "^13.3.0",
        "@testing-library/user-event": "^13.5.0",
        "@tippyjs/react": "^4.2.6",
        "antd": "^4.23.6",
        "axios": "^1.1.3",
        "classnames": "^2.3.1",
        "customize-cra": "^1.0.0",
        "electron-updater": "^6.8.9",
        "firebase": "^9.12.1",
        "normalize.css": "^8.0.1",
        "react": "^18.2.0",
        "react-app-rewired": "^2.2.1",
        "react-dom": "^18.2.0",
        "react-player": "^2.11.0",
        "react-rnd": "^10.4.1",
        "react-router-dom": "^6.3.0",
        "react-scripts": "5.0.1",
        "react-slick": "^0.29.0",
        "react-slider": "^2.0.4",
        "react-svg": "^15.1.8",
        "react-switch": "^7.0.0",
        "slick-carousel": "^1.8.1",
        "web-vitals": "^2.1.4"
    },
    "scripts": {
        "start": "react-app-rewired start",
        "build": "react-app-rewired build",
        "test": "react-app-rewired test",
        "eject": "react-scripts eject",
        "electron": "electron .",
        "electron:dev": "ELECTRON_START_URL=http://localhost:3000 electron .",
        "dist:linux": "react-app-rewired build && electron-builder --linux AppImage deb",
        "dist:win": "react-app-rewired build && electron-builder --win nsis portable",
        "dist:all": "react-app-rewired build && electron-builder -wl"
    },
    "build": {
        "appId": "com.lofito.app",
        "productName": "Lofito",
        "files": [
            "build/**/*",
            "!node_modules/**/*",
            "node_modules/electron-updater/**/*",
            "node_modules/builder-util-runtime/**/*",
            "node_modules/fs-extra/**/*",
            "node_modules/graceful-fs/**/*",
            "node_modules/jsonfile/**/*",
            "node_modules/universalify/**/*",
            "node_modules/js-yaml/**/*",
            "node_modules/argparse/**/*",
            "node_modules/esprima/**/*",
            "node_modules/lazy-val/**/*",
            "node_modules/lodash.escaperegexp/**/*",
            "node_modules/lodash.isequal/**/*",
            "node_modules/semver/**/*",
            "node_modules/sax/**/*",
            "node_modules/tiny-typed-emitter/**/*",
            "node_modules/debug/**/*",
            "node_modules/ms/**/*",
            "node_modules/sprintf-js/**/*"
        ],
        "directories": {
            "output": "dist-desktop"
        },
        "publish": [
            {
                "provider": "generic",
                "url": "https://lofito.josbert.dev/updates/"
            }
        ],
        "win": {
            "target": [
                "nsis",
                "portable"
            ],
            "icon": "public/icon.png"
        },
        "linux": {
            "target": [
                "AppImage",
                "deb"
            ],
            "maintainer": "Lofito <hola@bookforce.io>",
            "category": "AudioVideo",
            "icon": "public/icon.png"
        },
        "mac": {
            "target": [
                "dmg"
            ],
            "icon": "public/icon.png"
        }
    },
    "eslintConfig": {
        "extends": [
            "react-app",
            "react-app/jest"
        ]
    },
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    },
    "devDependencies": {
        "autoprefixer": "^10.4.8",
        "babel-plugin-module-resolver": "^4.1.0",
        "electron": "^43.3.0",
        "electron-builder": "^26.15.3",
        "postcss": "^8.4.16",
        "sass": "^1.54.5",
        "tailwindcss": "^3.1.8"
    }
}
