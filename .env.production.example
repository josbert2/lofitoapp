# Copiá a .env (junto a docker-compose.prod.yml) y completá los valores.
# NO commitear el .env real.

# --- MySQL ---
MYSQL_ROOT_PASSWORD=change-me-strong-root-pass
MYSQL_PASSWORD=change-me-strong-user-pass

# --- Auth ---
JWT_SECRET=change-me-long-random-string

# --- CORS: dominios que pueden pegarle a la API ---
